{
  "mcpServers": {
    "yahoo-finance": {
      "command": "uvx",
      "args": ["--system-certs", "--from", "git+https://github.com/Alex2Yang97/yahoo-finance-mcp", "yahoo-finance-mcp"]
    },
    "tradingview": {
      "command": "uvx",
      "args": ["--system-certs", "--from", "tradingview-mcp-server", "tradingview-mcp"]
    }
  }
}
